@model CreditWorksVehicleManagement.Models.VehicleCategory

@{
    ViewData["Title"] = "Add Category";
}

<div class="container py-4">

    <h1>Add Category</h1>

    <p class="text-muted">
        Define a vehicle weight category.
    </p>

    <div class="form-card p-4">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">
                    Category Name
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="MinWeightKg" class="form-label">
                    Minimum Weight (kg)
                </label>

                <input asp-for="MinWeightKg"
                       class="form-control"
                       type="number"
                       step="0.01"
                       min="0" />

                <span asp-validation-for="MinWeightKg"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="MaxWeightKg" class="form-label">
                    Maximum Weight (kg)
                </label>

                <input asp-for="MaxWeightKg"
                       class="form-control"
                       type="number"
                       step="0.01"
                       min="0" />

                <span asp-validation-for="MaxWeightKg"
                      class="text-danger">
                </span>

                <small class="text-muted">
                    Leave blank for the final category with no upper limit.
                </small>
            </div>

            <div class="mb-4">
                <label asp-for="Icon" class="form-label">
                    Icon
                </label>

                <select asp-for="Icon" class="form-select">
                    <option value="">Select an icon</option>
                    <option value="🚗">🚗 Car</option>
                    <option value="🚚">🚚 Truck</option>
                    <option value="🚛">🚛 Heavy Truck</option>
                    <option value="🚌">🚌 Bus</option>
                    <option value="🚐">🚐 Van</option>
                    <option value="🏎️">🏎️ Sports Car</option>
                </select>

                <span asp-validation-for="Icon"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Create Category
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}