@model CreditWorksVehicleManagement.Models.VehicleCategory

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container py-4">

    <h1>Delete Category</h1>

    <p class="text-muted">
        Review the category before deleting it.
    </p>

    <div class="form-card p-4">

        <div class="mb-4">

            <h4>
                @Model.Icon @Model.Name
            </h4>

            <p class="mb-1">
                <strong>Minimum Weight:</strong>
                @Model.MinWeightKg.ToString("0.00") kg
            </p>

            <p class="mb-0">
                <strong>Maximum Weight:</strong>
                @(Model.MaxWeightKg.HasValue
                                ? $"{Model.MaxWeightKg.Value:0.00} kg"
                                : "No limit")
            </p>

        </div>

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <p>
            Are you sure you want to delete this category?
        </p>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <button type="submit"
                    class="btn btn-danger">
                Delete Category
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>