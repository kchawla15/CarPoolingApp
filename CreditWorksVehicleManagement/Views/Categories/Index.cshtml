@model IEnumerable<CreditWorksVehicleManagement.Models.VehicleCategory>

@{
    ViewData["Title"] = "Categories";
}

<div class="container py-4">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Vehicle Categories</h1>
            <p class="text-muted">
                Manage vehicle weight categories.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Add Category
        </a>
    </div>

    <div class="data-table-card p-3">

        <table class="table align-middle mb-0">

            <thead>
                <tr>
                    <th>Icon</th>
                    <th>Name</th>
                    <th>Weight Range</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td style="font-size: 1.8rem;">
                            @category.Icon
                        </td>

                        <td>
                            @category.Name
                        </td>

                        <td>
                            @(category.MaxWeightKg.HasValue
                            ? $"{category.MinWeightKg:0.00} kg to less than {category.MaxWeightKg.Value:0.00} kg"
                            : $"{category.MinWeightKg:0.00} kg and above")
                    </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@category.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@category.Id"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                                }
            </tbody>

        </table>

    </div>

</div>