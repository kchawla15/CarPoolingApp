@model CreditWorksVehicleManagement.ViewModels.VehicleCreateViewModel

@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="container py-4">

    <div class="mb-4">
        <h1>Add Vehicle</h1>
        <p class="text-muted">
            Enter the vehicle details below.
        </p>
    </div>

    <div class="form-card p-4">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="OwnerName" class="form-label">
                    Owner Name
                </label>

                <input asp-for="OwnerName"
                       class="form-control"
                       placeholder="Enter owner name" />

                <span asp-validation-for="OwnerName"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="ManufacturerId" class="form-label">
                    Manufacturer
                </label>

                <select asp-for="ManufacturerId"
                        asp-items="Model.Manufacturers"
                        class="form-select">
                    <option value="">Select manufacturer</option>
                </select>

                <span asp-validation-for="ManufacturerId"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="YearOfManufacture" class="form-label">
                    Year of Manufacture
                </label>

                <input asp-for="YearOfManufacture"
                       class="form-control"
                       type="number"
                       min="1900"
                       max="@DateTime.Now.Year" />

                <span asp-validation-for="YearOfManufacture"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="WeightKg" class="form-label">
                    Weight (kg)
                </label>

                <input asp-for="WeightKg"
                       class="form-control"
                       type="number"
                       step="0.01"
                       min="0.01"
                       placeholder="Enter weight in kg" />

                <span asp-validation-for="WeightKg"
                      class="text-danger">
                </span>

                <small class="text-muted">
                    Weight can have a maximum of 2 decimal places.
                </small>
            </div>

            <div class="alert alert-light border mb-4">
                <strong>Category:</strong>
                The vehicle category will be determined automatically
                from its weight using the current category rules.
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Add Vehicle
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}