

@model CarPoolingApp.Models.Booking

<h2>Booking Confirmed</h2>

<div class="card p-3">

    @if (Model.Ride != null)
    {
        <p><strong>Ride:</strong> @Model.Ride.FromLocation → @Model.Ride.ToLocation</p>

        <p>
            <strong>Departure:</strong>
            @Model.Ride.DepartureTime.ToString("ddd, dd MMM yyyy h:mm tt")
        </p>

        <p><strong>Price:</strong> @Model.Ride.PricePerSeat.ToString("C")</p>
    }

    <p><strong>Payment Method:</strong> @Model.PaymentMethod</p>

    <p><strong>Status:</strong> Confirmed</p>

</div>

<br />

<a asp-action="FindRide" class="btn btn-primary">
    Back to Find Ride
</a>