@model CarPoolingApp.Models.Ride

@{
    ViewData["Title"] = "Edit Ride";
}

<section class="ride-page ride-form-shell">
    <aside class="ride-form-side">
        <p class="section-label">Update Ride</p>
        <h1>Edit ride details</h1>
        <p>
            Update route, timing, seating, and price while keeping the ride reference and booking information visible.
        </p>
        <ul>
            <li>Ride reference stays visible.</li>
            <li>Read-only values remain clearly separated.</li>
            <li>Changes still use your existing save action.</li>
        </ul>
    </aside>

    <div class="ride-form-card">
        <div class="card-intro">
            <p class="section-label">Ride Details</p>
            <h2>Edit ride #@Model.RideId</h2>
            <p>Adjust the route, schedule, seating, or price while keeping the stored ride metadata intact.</p>
        </div>

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="ride-grid">
                <div class="form-group">
                    <label>Ride ID</label>
                    <input value="@Model.RideId" class="form-control" readonly />
                </div>

                <div class="form-group">
                    <label asp-for="CreatedAt" class="control-label">Created on</label>
                    <input asp-for="CreatedAt" class="form-control" readonly />
                </div>

                <div class="form-group">
                    <label asp-for="FromLocation" class="control-label">Pickup location</label>
                    <input asp-for="FromLocation" class="form-control" />
                    <span asp-validation-for="FromLocation" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ToLocation" class="control-label">Destination</label>
                    <input asp-for="ToLocation" class="form-control" />
                    <span asp-validation-for="ToLocation" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DepartureTime" class="control-label">Departure date and time</label>
                    <input asp-for="DepartureTime" class="form-control" />
                    <span asp-validation-for="DepartureTime" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TotalSeats" class="control-label">Total seats</label>
                    <input asp-for="TotalSeats" class="form-control" />
                    <span asp-validation-for="TotalSeats" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AvailableSeats" class="control-label">Available seats</label>
                    <input asp-for="AvailableSeats" class="form-control" readonly />
                </div>

                <div class="form-group">
                    <label asp-for="PricePerSeat" class="control-label">Price per seat</label>
                    <input asp-for="PricePerSeat" class="form-control" />
                    <span asp-validation-for="PricePerSeat" class="text-danger"></span>
                </div>
            </div>

            <div class="action-row">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
