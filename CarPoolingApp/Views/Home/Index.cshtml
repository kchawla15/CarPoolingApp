@{
    ViewData["Title"] = "Home";
}

<section class="hero-shell">
    <div class="hero-copy">
        <p class="section-label">Share rides, Save money & Travel smarter</p>
        <h1>Share your ride. Lower the cost. Make every seat count.</h1>
        <p>
            RideMate helps drivers fill empty seats and helps passengers find smoother trips along routes that are already happening.
            No extra complexity, just a clearer way to connect everyday travel.
        </p>
        <div class="hero-actions">
            <a asp-controller="Rides" asp-action="FindRide" class="btn btn-primary">Find a Ride</a>
            <a asp-controller="Rides" asp-action="Create" class="btn btn-secondary">Offer a Ride</a>
        </div>
        <div class="hero-stat-grid">
            <div class="hero-stat">
                <strong>Shared fuel costs</strong>
                <span>Drivers recover trip expenses without changing their route.</span>
            </div>
            <div class="hero-stat">
                <strong>Faster daily travel</strong>
                <span>Passengers find practical rides without relying on fixed bus timing.</span>
            </div>
            <div class="hero-stat">
                <strong>Less empty space</strong>
                <span>More seats in use means a more efficient commute for everyone.</span>
            </div>
        </div>
    </div>

    <div class="hero-visual">
        <img src="/images/Carpool1.jpg" alt="Carpooling journey" class="hero-image" />
        <div class="floating-note note-top">
            <strong>Morning Route</strong>
            <span>City pickup with shared fuel cost</span>
        </div>
        <div class="floating-note note-bottom">
            <strong>Designed for regular trips</strong>
            <span>Simple ride posting and cleaner searching</span>
        </div>
    </div>
</section>

<section class="section-block">
    <div class="section-heading">
        <p class="section-label">Why RideMate</p>
        <h2>A warmer, simpler way to travel together</h2>
        <p>
            The platform already has the right building blocks. This refreshed interface makes them easier to understand,
            easier to trust, and more inviting to use on both desktop and mobile.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <article class="feature-card">
                <img src="/images/carpool-cost.jpg" alt="Save fuel costs" />
                <h3>Save fuel costs</h3>
                <p>Drivers can turn empty seats into shared trip value instead of carrying the full cost alone.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="feature-card">
                <img src="/images/carpool-time.jpg" alt="Save time" />
                <h3>Save time</h3>
                <p>Passengers can line up travel with real drivers already headed in the same direction.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="feature-card">
                <img src="/images/carpool-passenger.jpg" alt="Better use of cars" />
                <h3>Better use of cars</h3>
                <p>More occupied seats means fewer wasted trips and a more efficient transport routine overall.</p>
            </article>
        </div>
    </div>
</section>

<section class="section-block">
    <article class="story-card">
        <div class="story-media">
            <img src="/images/carpool-driver.jpg" alt="Driver offering a ride" />
        </div>
        <div class="story-copy">
            <span class="story-tag">For Drivers</span>
            <h3>Offer your route with clarity</h3>
            <p>
                Publish the trip you are already making, set your departure details, and make the available seats easy to understand at a glance.
                The updated UI keeps the process focused and calm instead of crowded.
            </p>
            <a asp-controller="Rides" asp-action="Create" class="btn btn-primary">Offer a Ride</a>
        </div>
    </article>
</section>

<section class="section-block">
    <article class="story-card reverse">
        <div class="story-media">
            <img src="/images/carpool-passenger.jpg" alt="Passenger finding a ride" />
        </div>
        <div class="story-copy">
            <span class="story-tag alt">For Passengers</span>
            <h3>Search routes without friction</h3>
            <p>
                Browse available rides by route and departure date, then compare the essentials quickly: timing, price, and seat availability.
                The interface now gives that information more room to breathe.
            </p>
            <a asp-controller="Rides" asp-action="FindRide" class="btn btn-secondary">Find a Ride</a>
        </div>
    </article>
</section>

<section class="section-block">
    <div class="cta-panel text-center">
        <p class="section-label justify-content-center">Start Here</p>
        <h2>Start your next trip with less clutter and more confidence</h2>
        <p>
            Use the refreshed ride search or post a new trip from the same familiar app structure you already have.
        </p>
        <div class="hero-actions justify-content-center">
            <a asp-controller="Rides" asp-action="FindRide" class="btn btn-primary">Find Available Rides</a>
            <a asp-controller="Rides" asp-action="Create" class="btn btn-secondary">Offer a Ride</a>
        </div>
    </div>
</section>
